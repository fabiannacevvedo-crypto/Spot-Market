# Base de datos MySQL
DB_NAME=spotmarket
DB_USER=root
DB_PASS=
DB_HOST=127.0.0.1
DB_PORT=3306

# Servidor Express
PORT=4000
NODE_ENV=development

# JWT (cookie httpOnly) - cambiá este secreto en producción
JWT_SECRET=cambiar_este_secreto_en_produccion

# CORS: origen del frontend (separá por coma si hay varios)
CORS_ORIGIN=http://localhost:5173

# Cloudinary: subida de imágenes (se guarda url + public_id en MySQL, nunca el binario)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
